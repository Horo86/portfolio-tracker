**/node_modules/
**/.data*/
**/test-results/
**/playwright-report/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
frontend/dist/
*.sqlite
*.sqlite-*
*.xlsx
.env
.env.*
